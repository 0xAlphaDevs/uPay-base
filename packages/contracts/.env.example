# Copy to .env (gitignored) and fill in — do not commit or paste these values anywhere.

# Public address of the wallet you funded with Base Sepolia ETH. Using it as both
# deployer and relayer is fine for now — split them later once things work.
RELAYER_ADDRESS=

# Private key of that same wallet (0x-prefixed). Pays for deployment gas.
DEPLOYER_PRIVATE_KEY=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Optional — only needed for `--verify`. Free at https://basescan.org/myapikey
BASESCAN_API_KEY=
