# Reown — get a project ID at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Merchant delegate signer
MERCHANT_DELEGATE_PRIVATE_KEY=

# UPayReceipt (Base) — onchain attribution/receipt log, see packages/contracts.
# Deploy to Base Sepolia first; set BASE_RECEIPT_NETWORK=mainnet once deployed to Base mainnet.
# BASE_RELAYER_PRIVATE_KEY's address must match the `relayer` the contract was deployed with —
# it only ever calls recordPayment(), never touches USDC, so a dedicated low-privilege key.
BASE_RELAYER_PRIVATE_KEY=
UPAY_RECEIPT_ADDRESS_BASE_SEPOLIA=
UPAY_RECEIPT_ADDRESS_BASE=
BASE_RECEIPT_NETWORK=sepolia

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
